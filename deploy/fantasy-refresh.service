[Unit]
Description=Refresh fantasy-assist (NHL stats, schedule, Yahoo rosters + free agents)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Same as the page's "Refresh data" button. A full free-agent pull takes a
# couple of minutes, hence the long timeout.
#
# strict=1: if the Yahoo half fails (the app keeps the old lists), the
# endpoint answers 502 instead of 200, and --fail-with-body makes curl exit
# non-zero while still printing the JSON -- so the run shows as failed in
# `systemctl status` and the reason is in journalctl. A 409 (a refresh
# already running) fails too; the next run catches up.
# No shell on purpose: quoting through systemd + sh is how the previous
# version's check broke.
ExecStart=/usr/bin/curl -sS --fail-with-body -X POST --max-time 900 http://127.0.0.1:8420/api/inseason/refresh?strict=1
